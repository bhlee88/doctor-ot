rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(h) { return signedIn() && exists(/databases/$(database)/documents/hospitals/$(h)/members/$(request.auth.uid)) && get(/databases/$(database)/documents/hospitals/$(h)/members/$(request.auth.uid)).data.active == true; }
    function admin(h) { return member(h) && get(/databases/$(database)/documents/hospitals/$(h)/members/$(request.auth.uid)).data.role == 'admin'; }
    match /hospitals/{h} {
      allow read: if member(h);
      allow write: if false;
      match /members/{uid} {
        allow read: if member(h);
        allow write: if false;
      }
      match /overtime/{id} {
        allow read: if member(h);
        allow create: if member(h) && request.resource.data.keys().hasOnly(['uid','name','date','minutes','createdAt','updatedAt']) && request.resource.data.keys().hasAll(['uid','name','date','minutes','createdAt','updatedAt']) && request.resource.data.uid == request.auth.uid && request.resource.data.name == get(/databases/$(database)/documents/hospitals/$(h)/members/$(request.auth.uid)).data.name && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.minutes is int && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 1440 && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
        allow update: if member(h) && resource.data.uid == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date','minutes','updatedAt']) && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.minutes is int && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 1440 && request.resource.data.updatedAt == request.time;
        allow delete: if member(h) && resource.data.uid == request.auth.uid;
      }
    }
  }
}
